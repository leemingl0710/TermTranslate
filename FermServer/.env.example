# Copy this file to .env, then fill in all three values (ask the team leader for DB_URL).
#   Mac:     cp .env.example .env
#   Windows: copy .env.example .env
# .env is in .gitignore — never commit it. Never put a real password in this file.

DB_URL=jdbc:postgresql://ep-xxxx-pooler.ap-southeast-1.aws.neon.tech:5432/neondb?sslmode=require
DB_USER=
DB_PASSWORD=

# --- PDF 텍스트 추출 (extractor) ---
# 비워 두면 기본값 사용. 이클립스에서 uv 를 못 찾으면 UV_PATH 에 전체 경로를 적는다.
#   Mac:     /Users/<이름>/.local/bin/uv        (터미널에서 `which uv` 로 확인)
#   Windows: C:\Users\<이름>\.local\bin\uv.exe  (명령 프롬프트에서 `where uv` 로 확인)
# 글자 추출 방식: python (기본, extractor 폴더) 또는 java (자바 추출기: pdftotext + Windows 내장 OCR).
# Windows 스마트 앱 컨트롤이 파이썬 파일을 막아 "애플리케이션 제어 정책에서 이 파일을 차단했습니다" 가 나오면 java
EXTRACTOR_ENGINE=python
# (java 일 때만, 보통은 비워 둠) pdftotext 를 자동으로 못 찾으면 경로 지정 (Git for Windows 의 mingw64\bin\pdftotext.exe)
# PDFTOTEXT_PATH=
# (java 일 때만) PDF 글자 층이 깨져 나오면 true: 모든 페이지를 Windows OCR 로 읽음
# PDF_FORCE_OCR=true
EXTRACTOR_DIR=../extractor
UV_PATH=
EXTRACTOR_TIMEOUT_SEC=600

# --- HTTP 서버 (ApiServer) ---
# 비워 두면 기본값. 로그인이 생기기 전까지 모든 업로드는 UPLOAD_USERNAME 사용자로 저장된다.
SERVER_PORT=8080
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
UPLOAD_USERNAME=admin

# --- 번역·요약 (term-translator, Server.translate.LlmTranslator) ---
# LLM_BASE_URL 을 비워 두면 번역하지 않고 추출 결과만 저장한다 (결과 화면: "Not available yet.").
# 내부 LLM 서비스 주소 (OpenAI 호환, 끝은 /v1 까지). API 키는 여기에만 적고 소스코드에 쓰지 않는다.
LLM_BASE_URL=
LLM_API_KEY=
# 쓸 모델 ID. {LLM_BASE_URL}/models 목록에 있는 이름 그대로
LLM_MODEL=gemma-4-26b
# 한 번에 AI 에 보낼 페이지 수. JSON 오류가 잦으면 2~3 으로 줄인다
TRANSLATE_BUNDLE_SIZE=4
# 요약·설명·퀴즈 언어 (번역문은 항상 쉬운 영어). 예: Vietnamese, Chinese, Mongolian, Uzbek
TRANSLATE_LANGUAGE=English
TRANSLATE_QUIZ_COUNT=3
# 추가 용어 사전 파일 (선택, .csv/.tsv 형식: ko,en,description). DB 의 terms 테이블과 합쳐서 쓴다
TERM_DICT_PATH=
# 서버가 response_format 옵션에서 400 오류를 내면 false
LLM_JSON_MODE=true
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SEC=300
# API 키의 분당 요청 한도. 요청 사이를 60/한도 초 이상 띄워서 한도를 넘지 않게 함 (0 이면 제한 없음)
LLM_RATE_LIMIT_PER_MIN=30
# vLLM 에서 Qwen 사고 모드를 끄려면 아래 주석 해제
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# LLM 없이 흐름만 확인: [DEMO] 가짜 문장이 공용 DB 에 저장되므로 혼자 쓰는 DB 에서만 켤 것
# TRANSLATE_DEMO=true
